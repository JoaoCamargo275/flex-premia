## Banco de dados
# Dev local (SQLite) — padrão, não precisa mudar para rodar localmente:
DATABASE_URL="file:./dev.db"

# Produção (Render) — Postgres. Ao trocar, edite também
# `datasource db { provider = "postgresql" ... }` em prisma/schema.prisma
# e rode `npm run db:deploy`.
# DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

## Autenticação (JWT)
# Gere um valor aleatório forte, ex: `openssl rand -base64 32`
JWT_SECRET="troque-por-um-segredo-aleatorio-longo"

## CORS — origem(s) do frontend (separadas por vírgula se houver mais de uma)
FRONTEND_ORIGIN="http://localhost:5173"

PORT=4000
